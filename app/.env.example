# MQTT broker WiCAN publishes to (optional - HTTP polling below is the main path)
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# WiCAN device id (from the device's config page / MAC-derived id), e.g. aabbccddeeff
# Leave blank to accept any device id (uses + wildcard).
WICAN_DEVICE_ID=

# Topic prefix that decoded AutoPID/vehicle-profile signals are published under.
# You choose this yourself when setting the "Send_to" field for each PID on the
# WiCAN Automate tab, e.g. Send_to=xpeng/soc -> prefix "xpeng"
SIGNAL_TOPIC_PREFIX=xpeng

# How many raw CAN frames to keep in the debug ring buffer
RAW_FRAME_BUFFER_SIZE=200

# How long (ms) a signal is considered "fresh" before status/derived fields
# start reporting stale data as unknown
SIGNAL_STALE_MS=120000

HTTP_PORT=8080

# How long (ms) to keep reporting the last known evcc status (B/C) after the
# WiCAN stops answering, before falling back to "A" (disconnected). Guards
# against brief WiCAN reboots/wifi blips. Default 15 min.
STATUS_HOLD_MS=900000

# WiCAN's own autopid_data endpoint, polled directly over HTTP
WICAN_HTTP_URL=http://<wican-ip>/autopid_data
WICAN_HTTP_POLL_MS=10000
