# WiCAN's own autopid_data endpoint, polled directly over HTTP (required)
WICAN_HTTP_URL=http://<wican-ip>/autopid_data
WICAN_HTTP_POLL_MS=10000

# How long (ms) a signal is considered "fresh" before status/derived fields
# start reporting stale data as unknown
SIGNAL_STALE_MS=120000

# How long (ms) to keep reporting the last known evcc status (B/C) after the
# WiCAN stops answering, before falling back to "A" (disconnected). Guards
# against brief WiCAN reboots/wifi blips. Default 15 min.
STATUS_HOLD_MS=900000

# Derived charge power (kW) above which status is reported as "C" (charging)
CHARGING_POWER_THRESHOLD_KW=0.2

HTTP_PORT=8080
